# CivicTrack Backend Environment Configuration Template
# Copy this file to .env in the backend/ folder:
#   Copy-Item .env.example .env

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/civictrack
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=24h

# CORS Configuration (Optional explicit origins, comma-separated)
# Localhost/127.0.0.1 on any port is automatically allowed by default
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Evidence Upload Storage Configuration
UPLOAD_DIR=./uploads/evidence
MAX_UPLOAD_SIZE_BYTES=10485760

# AI Civic Intelligence Engine (Optional)
# If provided, the backend queries Google Gemini for automated complaint classification,
# priority recommendations, and deduplication assistance.
# If omitted or offline, the platform automatically falls back to its built-in
# semantic NLP rule engine with 100% functionality and zero external API dependencies.
GEMINI_API_KEY=

# Initial Administrator Bootstrap Configuration (Server-side CLI script only)
INITIAL_ADMIN_NAME=Municipal Administrator
INITIAL_ADMIN_EMAIL=admin@civictrack.gov
INITIAL_ADMIN_PASSWORD=replace_with_secure_initial_admin_password
